# Copia este fichero a .env.local y rellena los valores (nunca lo subas a git)

# Supabase Storage para las imágenes subidas desde el panel (bucket gn-media)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE=sb_secret_...   # o la antigua service_role eyJ...

# Opcional: bucket propio (se crea solo en el primer arranque)
SUPABASE_STORAGE_BUCKET=gn-media

# Obligatorio en producción: secreto para firmar los JWT del admin
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Sin SUPABASE_* el servidor usa SQLite local (dev), con datos en server/data.db
