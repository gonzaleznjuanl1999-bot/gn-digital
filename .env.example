# Copia este fichero a .env.local y rellena los valores (nunca lo subas a git)

# Postgres (Supabase). Sin esta variable, el servidor usa SQLite local (dev).
DATABASE_URL=postgres://user:password@host:5432/postgres
PGSSL=1

# Obligatorio en producción: secreto para firmar los JWT del admin
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Supabase Storage para las imágenes subidas desde el panel (bucket gn-media)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...
SUPABASE_STORAGE_BUCKET=gn-media
